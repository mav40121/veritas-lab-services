# VeritaAssure environment configuration (template)
# Copy to .env and fill in real values. NEVER commit a filled-in .env.
# Grouped by purpose. "REQUIRED" vars must be set for the server to run
# correctly; "optional" features degrade gracefully (log a skip) when unset.
# Enumerated from process.env references in server/ + shared/ (2026-09-28).

# ---- Core secrets (REQUIRED) ----
JWT_SECRET=            # signs user session tokens. Generate: openssl rand -hex 64
ADMIN_SECRET=          # gates /api/admin/* endpoints. Generate: openssl rand -hex 32

# ---- Payments (REQUIRED for checkout; use test keys in non-prod) ----
STRIPE_SECRET_KEY=         # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=     # whsec_... (from the Stripe webhook endpoint)
# Optional recurring price IDs for add-ons (leave blank to run manual-invoice mode):
STRIPE_VIEW_ONLY_ADDON_PRICE=       # price_... ($99/yr view-only seat add-on)
STRIPE_STAFF_PORTAL_SMALL_PRICE=    # price_... (Staff Portal, <=25 staff)
STRIPE_STAFF_PORTAL_MEDIUM_PRICE=   # price_... (Staff Portal, <=100 staff)
STRIPE_STAFF_PORTAL_LARGE_PRICE=    # price_... (Staff Portal, <=250 staff)

# ---- Runtime / paths ----
NODE_ENV=production                 # development | production
PORT=5000                           # HTTP listen port (the only non-firewalled port on Railway)
DB_PATH=/data/veritas.db            # SQLite file. Falls back to ./veritas.db if /data is absent.
POLICY_STORAGE_ROOT=/data/policies  # on-disk store for VeritaPolicy/VeritaDC document uploads
FRONTEND_URL=                       # public base URL, e.g. https://www.veritaslabservices.com (used in emails/links)

# ---- Transactional + alert email (optional; unset = email steps skip) ----
RESEND_API_KEY=            # Resend API key. Unset disables outbound + backup-alert email.

# ---- Nightly off-site backup to S3-compatible storage (optional; unset = backup skips) ----
BACKUP_S3_ENDPOINT=        # e.g. https://<acct>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=          # bucket name
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ---- Error tracking (optional) ----
SENTRY_DSN=               # server-side Sentry DSN
VITE_SENTRY_DSN=          # client-side Sentry DSN (baked into the bundle at build time)

# ---- Owner seed identity (first-boot bootstrap of the initial owner account) ----
OWNER_EMAIL=              # initial owner login email
OWNER_CLIA=              # initial owner lab CLIA
SEED_USER_PLAN=          # optional plan for the seeded owner (e.g. system)

# ---- Deployment flavor toggles (optional) ----
STOCK_DEPLOYMENT=         # "1" for a VeritaStock-only deployment
VITE_STOCK_DEPLOYMENT=    # client mirror of STOCK_DEPLOYMENT
DEMO_NIGHTLY_RESET=       # "1" enables the nightly demo-tenant reset
DEMO_SINGLE_SITE=         # "1" for single-site demo mode
DEMO_USER_EMAIL=          # demo account email
DEMO_LOGIN_EMAIL=         # demo login email

# ---- Misc (optional) ----
EXCEL_PROTECT_PASSWORD=   # password used to protect generated Excel workbooks
# GIT_COMMIT_SHA / RAILWAY_GIT_COMMIT_SHA are set by the platform, not by hand.
